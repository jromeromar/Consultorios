# Secreto de firma de sesiones (JWT en cookie httpOnly). Obligatorio en producción.
# Genera uno con: openssl rand -base64 48
AUTH_SECRET=

# Postgres de producción (Neon / Supabase / Vercel Postgres).
# Si se deja vacío, la app usa PGlite embebido en .data/pglite (solo desarrollo).
DATABASE_URL=

# Modo demostración: base Postgres en memoria, migrada y sembrada en cada
# arranque en frío. Sirve para publicar una versión navegable sin base de datos.
# NO usar para producción real: nada persiste. Requiere AUTH_SECRET igualmente.
DEMO_MODE=

# Mercado por defecto para formato de cifras y moneda del benchmark.
NEXT_PUBLIC_LOCALE=es-CO
NEXT_PUBLIC_CURRENCY=COP
